# ==============================================================================
# SLATE POS — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE / BROWSER ACCESSIBLE VARIABLES (Prefixed with VITE_)
# Safe to expose in frontend bundles. Configured in Vercel & Vite.
# ------------------------------------------------------------------------------

# Supabase Project Integration (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Razorpay Commercial Subscription Integration (Dashboard -> Settings -> API Keys)
# Public Key ID used by client-side checkout to load hosted gateway
VITE_RAZORPAY_KEY_ID="rzp_live_your_key_id_here"

# Development Diagnostic Mode (Defaults to false, strictly false in production)
VITE_DEV_LOCAL_MODE=false


# ------------------------------------------------------------------------------
# 2. PRIVILEGED / SERVER-ONLY SECRETS (NEVER exposed to frontend/browser bundles)
# Configure these in Vercel Project Settings -> Environment Variables (Production & Preview)
# ------------------------------------------------------------------------------

# Supabase Elevated Service Role Key (Serverless Functions only)
# Used for backend database sync, administrative entitlement updates, and RLS bypass
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Razorpay API Secret Key
# Used for server-side order and subscription creation
RAZORPAY_KEY_SECRET="your-razorpay-secret-key"

# Razorpay Webhook Secret Key
# Used by /api/webhook to verify HMAC-SHA256 signature in 'x-razorpay-signature' header
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret-key"


# ------------------------------------------------------------------------------
# 3. RUNTIME SYSTEM VARIABLES (Auto-injected by platform)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
