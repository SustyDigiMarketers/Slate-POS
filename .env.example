# ==============================================================================
# SLATE POS — Finance & Accounting Environment Variables Template
# Copy to .env for local development ONLY (never commit .env to Git).
# Configure production values in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE / BROWSER ACCESSIBLE VARIABLES (Prefixed with VITE_)
# Safe to expose in Vite client bundles.
# ------------------------------------------------------------------------------

# Supabase Project URL & Public Anon Key (Supabase Dashboard -> Settings -> API)
# Example: https://your-project-ref.supabase.co (do NOT append /rest/v1 or /auth/v1)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Razorpay Public Key ID (Used for subscription checkout UI)
VITE_RAZORPAY_KEY_ID="rzp_live_your_key_id_here"

# Canonical Application URL (Used for password reset & auth redirect URLs)
VITE_APP_URL="https://your-slate-pos-domain.vercel.app"

# Local Development Diagnostic Bypass (MUST be false in Production & Preview)
VITE_DEV_LOCAL_MODE=false

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY PRIVILEGED SECRETS (NEVER prefix with VITE_)
# Used exclusively by /api/*.ts Vercel Serverless Functions & server.ts.
# ------------------------------------------------------------------------------

# Supabase Server URL & Service Role Key (Required for /api/onboarding, /api/provision-user, /api/accounting, /api/sync-push, /api/webhook)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Razorpay Server Credentials & Webhook Signing Secret
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your-razorpay-secret-key"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-signing-secret"

# Runtime Environment ("development" locally, "production" in Vercel/Cloud Run)
NODE_ENV="production"
